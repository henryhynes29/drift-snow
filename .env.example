# ============================================================
# DRIFT — environment variables
# Copy this file to ".env" for local dev. In Vercel, add each of
# these under Settings → Environment Variables.
#
# VITE_*  = PUBLIC (safe in the browser). Vite exposes only these.
# everything else = SERVER ONLY (used by /api functions). Never VITE_ them.
# ============================================================

# ---- Maps (already in use) ----
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token

# ---- Supabase (Phase 0: database, auth, realtime, storage) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# server-only (for /api functions and webhooks that write to the DB):
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ---- Stripe (Phase 1: payments + payouts) ----
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_CONNECT_CLIENT_ID=ca_your_connect_client_id

# ---- Later phases (add when you get to them) ----
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# RESEND_API_KEY=
# OPENWEATHER_API_KEY=
